{
  "manifest_version": 3,
  "name": "inno-creed 크레덴셜 브릿지",
  "version": "1.1.0",
  "description": "gw.innogrid.com 로그인 세션 쿠키를 inno-creed MCP 서버에 전달합니다 (Chrome/Edge).",
  "key": "",
  "permissions": ["cookies", "nativeMessaging", "alarms"],
  "host_permissions": ["*://gw.innogrid.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
